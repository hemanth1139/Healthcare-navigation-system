# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Healthcare Navigation System"
APP_VERSION="1.0.0"
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-256-bit-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/healthcare_db
DATABASE_ECHO=false

# ─── LLM Providers ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
PRIMARY_LLM_PROVIDER=gemini
# Options: gemini | groq

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ─── Cloudinary (Medical Record Storage) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── RAG / ChromaDB ───────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./app/rag/chroma_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Email (Password Reset) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Healthcare Navigator"

# ─── Frontend (CORS) ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── LangSmith (Optional Agent Monitoring) ────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=healthcare-navigator
