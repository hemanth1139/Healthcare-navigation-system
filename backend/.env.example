# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Healthcare Navigation System"
APP_VERSION="1.0.0"
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-256-bit-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./healthcare_db.db
# For Production PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_ECHO=false

# ─── LLM Provider (Google Gemini) ─────────────────────────────────────────────
# Primary API key
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=your-gemini-api-key-here
# Additional API keys for rotation (optional, helps manage free tier quotas)
GOOGLE_API_KEY_2=your-second-gemini-api-key-here
GOOGLE_API_KEY_3=your-third-gemini-api-key-here
GOOGLE_API_KEY_4=your-fourth-gemini-api-key-here
GOOGLE_API_KEY_5=your-fifth-gemini-api-key-here
PRIMARY_LLM_PROVIDER=gemini

# Groq for symptom assessment
GROQ_MODEL=openai/gpt-oss-120b
# Primary API key
GROQ_API_KEY=your-groq-api-key-here
# Additional API keys for rotation (optional, helps manage free tier quotas)
GROQ_API_KEY_2=your-second-groq-api-key-here
GROQ_API_KEY_3=your-third-groq-api-key-here
GROQ_API_KEY_4=your-fourth-groq-api-key-here
GROQ_API_KEY_5=your-fifth-groq-api-key-here


# ─── Google OAuth 2.0 (for Google login) ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ─── RAG Vector Store ─────────────────────────────────────────────────────────
VECTOR_STORE_DIRECTORY=./app/rag/vector_store

# ─── Email (Password Reset & Notifications) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Healthcare Navigator"

# ─── Frontend (CORS) ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── LangSmith (Optional Agent Monitoring) ────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=healthcare-navigator
