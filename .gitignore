# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root & frontend subfolder)
/node_modules
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (root & frontend subfolder)
/.next/
.next/
/out/

# production
/build

# temp/scratch files
scratch_move.js

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ─── Python / Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Alembic generated (keep versions tracked)
# alembic/versions/

# ChromaDB vector store (large, regenerable)
backend/app/rag/chroma_store/

# ML model artifacts (large binaries)
backend/app/ml/artifacts/*.pkl
backend/app/ml/artifacts/*.json
backend/app/ml/artifacts/*.ubj

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite & Uploaded Media
*.db
*.sqlite3
backend/app/uploads/*.mp3
app/
